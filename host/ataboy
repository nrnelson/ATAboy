NO_DEVICE_CMDS = {"list", "wait"}


def _maybe_sudo(args, argv):
    if os.geteuid() == 0 or args.no_sudo or args.cmd in NO_DEVICE_CMDS:
        return
    script = os.path.abspath(sys.argv[0])
    extra = ["--json"] if args.json and "-j" not in argv and "--json" not in argv else []
    if args.dev is None and os.environ.get("ATABOY_DEV"):
        extra += ["--dev", os.environ["ATABOY_DEV"]]
    cmd = [sys.executable, script] + extra + argv
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        os.execvp("sudo", ["sudo", "-n", "--"] + cmd)
    if sys.stdin.isatty():
        os.execvp("sudo", ["sudo", "--"] + cmd)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv)
    _maybe_sudo(args, argv)
    dev = None
    try:
        if args.cmd not in NO_DEVICE_CMDS:
            dev = ATAboy(args.dev)
        return args.fn(args, dev)
    except ApiError as e:
        obj = e.reply.json if isinstance(e.reply.json, dict) else {"result": e.reply.result_name}
        _emit(args, obj, lambda o: print("error: %s" % e, file=sys.stderr))
        return EXIT_DEVICE
    except PermissionError as e:
        _emit(args, {"result": "permission_denied", "message": str(e)},
              lambda o: print("error: %s (run as root)" % e, file=sys.stderr))
        return EXIT_PERM
    except (TransportError, ScsiCheckCondition) as e:
        if isinstance(e, ScsiCheckCondition) and (e.key, e.asc) == (5, 0x24) and dev and dev.info_dev \
                and not dev.info_dev["rev"].startswith("api"):
            e = TransportError("firmware revision '%s' does not implement the API; flash the API firmware"
                               % dev.info_dev["rev"])
        _emit(args, {"result": "transport_error", "message": str(e)},
              lambda o: print("error: %s" % e, file=sys.stderr))
        return EXIT_TRANSPORT
    finally:
        if dev:
            dev.close()


if __name__ == "__main__":
    sys.exit(main())
