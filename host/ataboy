        with open(args.raw, "wb") as f:
            f.write(raw)
    d = decode_identify(raw)
    if args.words:
        d["words"] = list(struct.unpack("<256H", raw))
    _emit(args, d, lambda d: [print("%-20s %s" % (k, v)) for k, v in d.items() if k != "words"])
    return EXIT_OK


def cmd_taskfile(args, dev):
    _emit(args, dev.taskfile(), lambda j: print(
        "ERR %02X[%s] CNT %02X LBA %02X/%02X/%02X DEV %02X ST %02X[%s]%s" % (
            j["error"], j["error_bits"], j["count"], j["lba_lo"], j["lba_mid"], j["lba_hi"],
            j["device"], j["status"], j["status_bits"], "" if j["valid"] else "  (BSY: registers invalid)")))
    return EXIT_OK


def cmd_read(args, dev):
    """Read a range in chunks; per-chunk diagnostics; optional output / image patching."""
    maxn = dev.info().get("max_read_sectors", 7)
    lba, end = args.lba, args.lba + args.count
    results, bad, ok_sectors = [], [], 0
    out = open(args.out, "r+b" if os.path.exists(args.out) and args.image else "wb") if args.out else None
    status = EXIT_OK
    try:
        while lba < end:
            n = min(maxn, end - lba) if not bad or args.chunk_after_error == 0 else 1
            r = dev.read(lba, n, no_retry=args.no_retry, through_error=args.through_error,
                         timeout_ms=args.timeout)
            got = r.done + (1 if r.err_data else 0)
            if out and got:
                out.seek(((lba if args.image else lba - args.lba)) * 512)
                out.write(r.data[:got * 512])
            ok_sectors += r.done
            results.append(r.to_dict(with_data=args.hex and not out))
            if not r.ok:
                status = EXIT_DEVICE
                fl = r.fail_lba if r.fail_lba is not None else lba + r.done
                bad.append(fl)
                if not args.keep_going:
                    break
                lba = max(fl + 1, lba + max(1, r.done))
            else:
                lba += n
            if args.hexdump and not args.json and got:
                _hexdump(r.data[:got * 512], (lba - got) * 512)
    finally:
        if out:
            out.close()
    summary = {"result": "ok" if not bad else "errors", "start": args.lba, "count": args.count,
               "ok_sectors": ok_sectors, "bad_lbas": bad, "chunks": results}
    _emit(args, summary, lambda s: ([human_ata_result(c) for c in s["chunks"] if c["result"] != "ok" or args.verbose],
                                    print("read %d sectors from LBA %d: %d ok, %d bad%s" % (
                                        s["count"], s["start"], s["ok_sectors"], len(s["bad_lbas"]),
                                        (" " + str(s["bad_lbas"][:20])) if s["bad_lbas"] else ""))))
    return status


def cmd_readlong(args, dev):
    reads = []
    for _ in range(max(1, args.vote)):
        r = dev.read_long(args.lba, ecc_len=args.ecc, no_retry=args.no_retry, timeout_ms=args.timeout)
        reads.append(r)
        if not r.data:
            break
    last = reads[-1]
    out = last.to_dict()
    payload = last.data
    if args.vote > 1 and all(r.data for r in reads):
        n = len(reads[0].data)
        voted = bytearray(n)
        unstable = 0
        for i in range(n):
            col = [r.data[i] for r in reads]
            best = max(set(col), key=col.count)
            voted[i] = best
            unstable += len(set(col)) > 1
        payload = bytes(voted)
        out["vote"] = {"reads": len(reads), "unstable_bytes": unstable}
    if payload:
        out["ecc_hex"] = payload[512:].hex()
        if args.out:
            with open(args.out, "wb") as f:
                f.write(payload if args.with_ecc else payload[:512])
            out["written"] = args.out
        if args.image:
            with open(args.image, "r+b") as f:
                f.seek(args.lba * 512)
                f.write(payload[:512])
            out["patched_image"] = args.image
    _emit(args, out, lambda o: (human_ata_result(o), print("ECC bytes: %s%s" % (o.get("ecc_hex", "-"),
          ("  vote: %d reads, %d unstable bytes" % (o["vote"]["reads"], o["vote"]["unstable_bytes"])) if "vote" in o else ""))))
    return EXIT_OK if last.data else EXIT_DEVICE


def cmd_verify(args, dev):
    lba, end = args.lba, args.lba + args.count
    bad, t0, requests = [], time.time(), 0
    while lba < end:
        r = dev.verify(lba, end - lba, timeout_ms=args.timeout)
        requests += 1
        lba += r.done
        if r.result == "ok" and not r.partial and lba >= end:
            break
        if r.result != "ok":
            bad.append({"lba": lba, "status": r.status, "error": r.error, "error_bits": bits(r.error, ER_BITS),
                        "ide_result": r.ide_result})
            if not args.json:
                print("bad LBA %d  st %02X err %02X[%s] %s" % (lba, r.status, r.error, bits(r.error, ER_BITS), r.ide_result),
                      flush=True)
            lba += 1
            if args.max_errors and len(bad) >= args.max_errors:
                break
        if not args.json and args.progress:
            print("  ... %d / %d" % (lba - args.lba, args.count), file=sys.stderr, flush=True)
    out = {"result": "ok" if not bad else "errors", "start": args.lba, "count": args.count,
           "scanned": lba - args.lba, "bad": bad, "seconds": round(time.time() - t0, 1), "requests": requests}
    _emit(args, out, lambda o: print("verified %d sectors from LBA %d in %.1f s: %d bad" % (
        o["scanned"], o["start"], o["seconds"], len(o["bad"]))))
    return EXIT_OK if not bad else EXIT_DEVICE


