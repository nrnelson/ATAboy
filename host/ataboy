    _emit(args, dev.clear(log=not args.stats_only, stats=args.stats or args.stats_only))
    return EXIT_OK


def cmd_arm(args, dev):
    _emit(args, dev.arm(), lambda j: print(j["message"]))
    return EXIT_OK


def cmd_reboot(args, dev):
    _emit(args, dev.reboot(bootsel=args.bootsel), lambda j: print(j["message"]))
    return EXIT_OK


def cmd_wait(args, dev_unused):
    t0 = time.time()
    while time.time() - t0 < args.timeout:
        devs = find_devices()
        if devs:
            try:
                with ATAboy(devs[0]["sg"] or devs[0]["block"]) as d:
                    info = d.info()
                _emit(args, {"result": "ok", "device": devs[0], "info": info,
                             "waited_s": round(time.time() - t0, 1)},
                      lambda o: print("%s is up: %s (%s)" % (o["device"]["block"], o["info"]["fw"], o["info"]["git"])))
                return EXIT_OK
            except (TransportError, ScsiCheckCondition, OSError):
                pass
        time.sleep(0.5)
    _emit(args, {"result": "timeout", "waited_s": args.timeout}, lambda o: print("no ATAboy after %d s" % args.timeout))
    return EXIT_TRANSPORT


def cmd_ata(args, dev):
    if args.dangerous:
        dev.arm()
    data_out = open(args.write, "rb").read() if args.write else None
    r = dev.ata(args.command, feature=args.feature, count=args.count, lba=args.lba,
                device=args.device, ext=args.ext, data_in=args.read * 512,
                data_out=data_out, ck_cond=not args.no_ck, timeout_ms=args.timeout)
    data = r.pop("data", b"")
    if data and args.out:
        with open(args.out, "wb") as f:
            f.write(data)
        r["written"] = args.out
    elif data:
        r["data_hex"] = data.hex()
    _emit(args, r, lambda r: (print(" ".join("%s=%s" % (k, ("%02X" % v) if isinstance(v, int) and k in ("status", "error", "device") else v)
                                             for k, v in r.items() if k != "data_hex")),
                              data and not args.out and _hexdump(data)))
    return EXIT_OK if r.get("ok") else EXIT_DEVICE


def build_parser():
    p = argparse.ArgumentParser(prog="ataboy", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-d", "--dev", default=os.environ.get("ATABOY_DEV"),
                   help="/dev/sgN or /dev/sdX (default: first ATAboy found; env ATABOY_DEV)")
    p.add_argument("-j", "--json", action="store_true", default=os.environ.get("ATABOY_JSON") == "1",
                   help="machine-readable JSON output (env ATABOY_JSON=1)")
    p.add_argument("--compact", action="store_true", help="single-line JSON")
    p.add_argument("--no-sudo", action="store_true", help="don't re-run under sudo when not root")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--version", action="version", version="ataboy " + __version__)
    sp = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    # The common options are also accepted after the subcommand
    # ("ataboy status -j"); SUPPRESS keeps the top-level value unless given.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-d", "--dev", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("-j", "--json", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--compact", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("-v", "--verbose", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    def add(name, fn, help_):
        x = sp.add_parser(name, help=help_, description=help_, parents=[common])
        x.set_defaults(fn=fn)
        return x

    add("list", cmd_list, "list attached ATAboys (no root needed)")
    add("info", cmd_info, "firmware identity, protocol version, capabilities")
    add("status", cmd_status, "drive, geometry, mount, config, stats and last error in one call")
    x = add("config", cmd_config, "show or change settings: config read_timeout_ms=15000 no_retry=1 --save")
    x.add_argument("settings", nargs="*", help="key=value (" + ", ".join(CONFIG_KEYS) + ")")
    x.add_argument("--save", action="store_true", help="persist to flash")
    x = add("detect", cmd_detect, "probe the bus, IDENTIFY, choose geometry (optionally mount)")
    x.add_argument("--device", choices=["auto", "master", "slave"], default="auto")
    x.add_argument("--geometry", choices=list(GEOMETRY_MODES), default="auto",
                   help="auto = LBA if supported, else NORMAL (default)")
    x.add_argument("--chs", type=_chs, help="C/H/S for --geometry manual")
    x.add_argument("--no-probe", action="store_true", help="skip bus reset/probe; just IDENTIFY")
    x.add_argument("--force", action="store_true", help="accept manual geometry if IDENTIFY fails")
    x.add_argument("--mount", action="store_true", help="mount on success")
    x = add("geometry", cmd_geometry, "set geometry from cached IDENTIFY data or manual C/H/S")
    x.add_argument("mode", choices=["normal", "large", "lba", "manual"])
    x.add_argument("--chs", type=_chs)
    x = add("mount", cmd_mount, "expose the drive as USB mass storage (and rescan the host disk)")
    x.add_argument("--no-rescan", action="store_true")
    x = add("unmount", cmd_unmount, "detach the drive from USB mass storage")
    x.add_argument("--no-rescan", action="store_true")
    x = add("reset", cmd_reset, "soft reset (SRST); --hard pulses the RESET line and recalibrates")
    x.add_argument("--hard", action="store_true")
