EXIT_OK, EXIT_DEVICE, EXIT_USAGE, EXIT_TRANSPORT, EXIT_PERM = 0, 1, 2, 3, 4


def _emit(args, obj, human=None):
    if args.json:
        print(json.dumps(obj, indent=None if args.compact else 2, default=lambda b: b.hex()))
    elif human is not None:
        human(obj)
    else:
        print(json.dumps(obj, indent=2, default=lambda b: b.hex()))


def _hexdump(data, base=0):
    for off in range(0, len(data), 16):
        chunk = data[off:off + 16]
        hx = " ".join("%02x" % b for b in chunk)
        asc = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        print("%08x  %-47s  %s" % (base + off, hx, asc))


def _chs(s):
    try:
        c, h, sp = (int(x) for x in s.replace(",", "/").split("/"))
        return c, h, sp
    except ValueError:
        raise argparse.ArgumentTypeError("CHS must look like 989/10/34")


def _int(s):
    return int(s, 0)


def human_status(j):
    d, g = j["drive"], j["geometry"]
    print("firmware   %s  (uptime %.1f s)" % (j["fw"], j["uptime_ms"] / 1000))
    if d["identified"] or d["forced"]:
        print("drive      %s  serial %s  fw %s  [%s]" % (d["model"], d["serial"] or "-", d["firmware"] or "-", d["device"]))
    else:
        print("drive      %s" % ("present, not identified" if d["present"] else "not detected"))
    if g["valid"]:
        print("geometry   %s %s  %d/%d/%d  %d sectors (%.1f MB)" % (
            g["mode"], g["addressing"], g["cyls"], g["heads"], g["spt"], g["sectors"], g["sectors"] * 512 / 1e6))
    else:
        print("geometry   not set")
    c = j["config"]
    print("state      %s, write protect %s, read timeout %d ms%s%s" % (
        "MOUNTED" if j["mounted"] else "not mounted", "ON" if j["write_protect"] else "OFF",
        c["read_timeout_ms"], ", no-retry reads" if c["no_retry"] else "", ", ARMED" if j["armed"] else ""))
    print("bus        status %02X %s" % (j["bus"]["status"], j["bus"]["status_bits"]))
    s = j["stats"]
    print("stats      reads %d (%d sectors, %d errors)  writes %d (%d errors)  timeouts %d  recoveries %d" % (
        s["read_cmds"], s["read_sectors"], s["read_errors"], s["write_cmds"], s["write_errors"],
        s["timeouts"], s["recoveries"]))
    e = j["errors"]
    print("errors     %d logged" % e["total"])
    if e["last"]:
        human_log_entry(e["last"], prefix="  last     ")


def human_log_entry(x, prefix=""):
    print("%s#%-4d t=%9.3fs %-10s cmd %02X LBA %-9d fail %-9d st %02X[%s] err %02X[%s] %s %d/%d ms%s" % (
        prefix, x["seq"], x["t_ms"] / 1000, x["op"], x["cmd"], x["lba"], x["fail_lba"],
        x["status"], x["status_bits"], x["error"], x["error_bits"], x["result"],
        x["elapsed_ms"], x["timeout_ms"], "" if x["tf_valid"] else " (regs invalid: BSY)"))


def human_ata_result(r):
    d = r if isinstance(r, dict) else r.to_dict()
    print("%s  LBA %d  %d/%d sectors  st %02X[%s] err %02X[%s]  %.1f ms%s%s%s" % (
        d["result"].upper(), d["lba"], d["done"], d["count"], d["status"], d["status_bits"],
        d["error"], d["error_bits"], d["elapsed_ms"],
        "  fail_lba %d" % d["fail_lba"] if d["fail_lba"] is not None else "",
        "  (data returned despite error)" if d["err_data"] else "",
        "  TIMEOUT" if d["timed_out"] else ""))


def cmd_list(args, dev):
    _emit(args, find_devices(), lambda l: [print("%s  %s  rev %s  %d sectors" % (
        d["block"], d["sg"], d["rev"], d["size_sectors"])) for d in l] or (not l and print("no ATAboy found")))
    return EXIT_OK


def cmd_info(args, dev):
    _emit(args, dev.info(), lambda j: print("%s (%s, proto %d) built %s  board %s %s" % (
        j["fw"], j["git"], j["proto"], j["built"], j["board"], j["board_id"])))
    return EXIT_OK


def cmd_status(args, dev):
    j = dev.status()
    if dev.info_dev:
        j["host"] = {k: dev.info_dev[k] for k in ("block", "sg", "scsi_timeout_s")}
    _emit(args, j, human_status)
    return EXIT_OK


def cmd_config(args, dev):
    cfg = None
    for kv in args.settings:
        if "=" not in kv:
            raise SystemExit("settings look like key=value; keys: " + ", ".join(CONFIG_KEYS))
        k, v = kv.split("=", 1)
        k = k.replace("-", "_")
        if k == "read_timeout":
            k = "read_timeout_ms"
        if k not in CONFIG_KEYS:
            raise SystemExit("unknown key %s; keys: %s" % (k, ", ".join(CONFIG_KEYS)))
        cfg = dev.set_config(k, v)
    if args.save:
        dev.save()
    if cfg is None:
        cfg = dev.config()
    out = {"result": "ok", "config": cfg, "saved": bool(args.save)}
    if dev.info_dev:
        out["kernel_scsi_timeout_s"] = int(_read(dev.info_dev["sysfs"] + "/timeout") or 0)
    _emit(args, out, lambda o: [print("%-18s %s" % (k, v)) for k, v in o["config"].items()])
    return EXIT_OK


def _status_reply(args, r, what):
    j = r.json or {}
    _emit(args, j, lambda j: (print("%s: %s%s" % (what, j.get("result"), (" - " + j["message"]) if j.get("message") else "")),
                              j.get("drive") and human_status(j)))
    return EXIT_OK if r.ok else EXIT_DEVICE


def cmd_detect(args, dev):
    r = dev.detect(device=args.device, geometry=args.geometry, chs=args.chs,
                   probe=not args.no_probe, force=args.force, mount=args.mount)
    return _status_reply(args, r, "detect")


def cmd_geometry(args, dev):
    return _status_reply(args, dev.geometry(args.mode, args.chs), "geometry")


def cmd_mount(args, dev):
    r = dev.mount(rescan=not args.no_rescan)
    return _status_reply(args, r, "mount")


def cmd_unmount(args, dev):
    return _status_reply(args, dev.unmount(rescan=not args.no_rescan), "unmount")


def cmd_reset(args, dev):
    return _status_reply(args, dev.reset(hard=args.hard), "reset")


def cmd_identify(args, dev):
    raw = dev.identify(cached=args.cached)
    if args.raw:
        with open(args.raw, "wb") as f:
            f.write(raw)
    d = decode_identify(raw)
    if args.words:
        d["words"] = list(struct.unpack("<256H", raw))
    _emit(args, d, lambda d: [print("%-20s %s" % (k, v)) for k, v in d.items() if k != "words"])
    return EXIT_OK


def cmd_taskfile(args, dev):
    _emit(args, dev.taskfile(), lambda j: print(
        "ERR %02X[%s] CNT %02X LBA %02X/%02X/%02X DEV %02X ST %02X[%s]%s" % (
            j["error"], j["error_bits"], j["count"], j["lba_lo"], j["lba_mid"], j["lba_hi"],
            j["device"], j["status"], j["status_bits"], "" if j["valid"] else "  (BSY: registers invalid)")))
    return EXIT_OK


def cmd_read(args, dev):
    """Read a range in chunks; per-chunk diagnostics; optional output / image patching."""
    res = dev.read_range(args.lba, args.count, out=args.out, image=args.image, no_retry=args.no_retry,
                         through_error=args.through_error, timeout_ms=args.timeout,
                         keep_going=args.keep_going, keep_data=args.hex or args.hexdump)
    data = res.pop("data", b"")
    if args.hex:
        res["data_hex"] = data.hex()
    _emit(args, res, lambda s: ([human_ata_result(c) for c in s["chunks"] if c["result"] != "ok" or args.verbose],
                                print("read %d sectors from LBA %d: %d ok, %d bad%s" % (
                                    s["count"], s["start"], s["ok_sectors"], len(s["bad_lbas"]),
                                    (" " + str(s["bad_lbas"][:20])) if s["bad_lbas"] else "")),
                                args.hexdump and _hexdump(data, args.lba * 512)))
    return EXIT_OK if res["result"] == "ok" else EXIT_DEVICE


def cmd_readlong(args, dev):
    payload, out = dev.read_long_vote(args.lba, votes=args.vote, ecc_len=args.ecc,
                                      no_retry=args.no_retry, timeout_ms=args.timeout)
    if payload:
        out["ecc_hex"] = payload[512:].hex()
        if args.out:
            with open(args.out, "wb") as f:
                f.write(payload if args.with_ecc else payload[:512])
            out["written"] = args.out
        if args.image:
            with open(args.image, "r+b") as f:
                f.seek(args.lba * 512)
                f.write(payload[:512])
            out["patched_image"] = args.image
    _emit(args, out, lambda o: (human_ata_result(o), print("ECC bytes: %s%s" % (o.get("ecc_hex", "-"),
          ("  vote: %d reads, %d unstable bytes" % (o["vote"]["reads"], o["vote"]["unstable_bytes"])) if "vote" in o else ""))))
    return EXIT_OK if payload else EXIT_DEVICE


def cmd_verify(args, dev):
    prog = None if args.json else (lambda s: print(s, flush=True))
    out = dev.scan(args.lba, args.count, timeout_ms=args.timeout, max_errors=args.max_errors,
                   time_budget_s=args.budget, progress=prog)
    _emit(args, out, lambda o: print("verified %d sectors from LBA %d in %.1f s: %d bad%s" % (
        o["scanned"], o["start"], o["seconds"], len(o["bad"]),
        "" if o["complete"] else " (stopped early; resume at LBA %s)" % o["next_lba"])))
    return EXIT_OK if not out["bad"] else EXIT_DEVICE


def cmd_image(args, dev):
    prog = None if args.json else (lambda s: print(s, flush=True))
    out = dev.image(args.out, mapfile=args.mapfile, start=args.start, count=args.count,
                    time_budget_s=args.budget, progress=prog)
    _emit(args, out, lambda o: print("imaged %d sectors in %.1f s (%s kB/s), %d bad%s; map %s" % (
        o["imaged_sectors"], o["seconds"], o["kB_per_s"], len(o["bad_lbas"]),
        "" if o["complete"] else " (time budget ran out; run again to resume)", o["mapfile"])))
    return EXIT_OK if not out["bad_lbas"] else EXIT_DEVICE


def cmd_rescue(args, dev):
    prog = None if args.json else (lambda s: print(s, flush=True))
    before = Mapfile.load(args.mapfile).summary()
    out = dev.rescue(args.image, args.mapfile, timeout_ms=args.timeout, votes=args.vote,
                     readlong=not args.no_readlong, no_retry_pass=not args.no_fast_pass,
                     max_sectors=args.max_sectors, time_budget_s=args.budget, progress=prog,
                     include_untried=args.include_untried)
    out["map_before"] = before
    out["map_after"] = Mapfile.load(args.mapfile).summary()
    _emit(args, out, lambda o: print("rescue: %d candidate sectors, %d recovered (%d fast, %d with retries), "
                                     "%d READ LONG, %d still bad%s" % (
        o["candidates"], o["recovered"], len(o["recovered_no_retry"]), len(o["recovered_retry"]),
        len(o["readlong"]), len(o["still_bad"]), "" if o["complete"] else " (time budget ran out)")))
    return EXIT_OK if not out["still_bad"] else EXIT_DEVICE


def cmd_corrupt(args, dev):
    r = dev.corrupt(args.lba, bits=args.bits, ecc_len=args.ecc)
    _emit(args, r.to_dict(), human_ata_result)
    return EXIT_OK if r.ok else EXIT_DEVICE


def cmd_log(args, dev):
    j = dev.log()
    if args.clear:
        dev.clear(log=True)
        j["cleared"] = True
    _emit(args, j, lambda j: ([human_log_entry(x) for x in j["entries"]],
                              print("%d failures logged, %d retained" % (j["total"], j["retained"]))))
    return EXIT_OK


def cmd_clear(args, dev):
    _emit(args, dev.clear(log=not args.stats_only, stats=args.stats or args.stats_only))
    return EXIT_OK


def cmd_arm(args, dev):
    _emit(args, dev.arm(), lambda j: print(j["message"]))
    return EXIT_OK


def cmd_reboot(args, dev):
    j = dev.reboot(bootsel=args.bootsel)
    block = dev.info_dev["block"] if dev.info_dev else None
    dev.close()
    # The firmware reboots ~200 ms after replying; don't return while the old
    # instance is still answering, or a following "wait" would talk to it.
    t0 = time.time()
    while block and os.path.exists("/sys/block/" + os.path.basename(block)) and time.time() - t0 < 5:
        time.sleep(0.1)
    j["gone_after_s"] = round(time.time() - t0, 2)
    _emit(args, j, lambda j: print(j["message"]))
    return EXIT_OK


def cmd_wait(args, dev_unused):
    t0 = time.time()
    last_exec = 0
    while time.time() - t0 < args.timeout:
        devs = find_devices()
        if not devs and args.exec_cmd and time.time() - last_exec > 3:
            subprocess.run(args.exec_cmd, shell=True, capture_output=True)   # e.g. usbipd attach
            last_exec = time.time()
        if devs:
            try:
                if os.geteuid() == 0:
                    with ATAboy(devs[0]["sg"] or devs[0]["block"]) as d:
                        info = d.info()
                else:       # no root: identify from sysfs (INQUIRY revision) only
                    info = {"fw": "rev " + devs[0]["rev"], "git": "run as root for details"}
                _emit(args, {"result": "ok", "device": devs[0], "info": info,
                             "waited_s": round(time.time() - t0, 1)},
                      lambda o: print("%s is up: %s (%s)" % (o["device"]["block"], o["info"]["fw"], o["info"]["git"])))
                return EXIT_OK
            except (TransportError, ScsiCheckCondition, OSError):
                pass
        time.sleep(0.5)
    _emit(args, {"result": "timeout", "waited_s": args.timeout}, lambda o: print("no ATAboy after %d s" % args.timeout))
    return EXIT_TRANSPORT


def cmd_ata(args, dev):
    if args.dangerous:
        dev.arm()
    data_out = open(args.write, "rb").read() if args.write else None
    r = dev.ata(args.command, feature=args.feature, count=args.count, lba=args.lba,
                device=args.device, ext=args.ext, data_in=args.read * 512,
                data_out=data_out, ck_cond=not args.no_ck, timeout_ms=args.timeout)
    data = r.pop("data", b"")
    if data and args.out:
        with open(args.out, "wb") as f:
            f.write(data)
        r["written"] = args.out
    elif data:
        r["data_hex"] = data.hex()
    _emit(args, r, lambda r: (print(" ".join("%s=%s" % (k, ("%02X" % v) if isinstance(v, int) and k in ("status", "error", "device") else v)
                                             for k, v in r.items() if k != "data_hex")),
                              data and not args.out and _hexdump(data)))
    return EXIT_OK if r.get("ok") else EXIT_DEVICE


def build_parser():
    p = argparse.ArgumentParser(prog="ataboy", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-d", "--dev", default=os.environ.get("ATABOY_DEV"),
                   help="/dev/sgN or /dev/sdX (default: first ATAboy found; env ATABOY_DEV)")
    p.add_argument("-j", "--json", action="store_true", default=os.environ.get("ATABOY_JSON") == "1",
                   help="machine-readable JSON output (env ATABOY_JSON=1)")
    p.add_argument("--compact", action="store_true", help="single-line JSON")
    p.add_argument("--no-sudo", action="store_true", help="don't re-run under sudo when not root")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--version", action="version", version="ataboy " + __version__)
    sp = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    # The common options are also accepted after the subcommand
    # ("ataboy status -j"); SUPPRESS keeps the top-level value unless given.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-d", "--dev", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("-j", "--json", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--compact", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("-v", "--verbose", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    def add(name, fn, help_):
        x = sp.add_parser(name, help=help_, description=help_, parents=[common])
        x.set_defaults(fn=fn)
        return x

    add("list", cmd_list, "list attached ATAboys (no root needed)")
    add("info", cmd_info, "firmware identity, protocol version, capabilities")
    add("status", cmd_status, "drive, geometry, mount, config, stats and last error in one call")
    x = add("config", cmd_config, "show or change settings: config read_timeout_ms=15000 no_retry=1 --save")
    x.add_argument("settings", nargs="*", help="key=value (" + ", ".join(CONFIG_KEYS) + ")")
    x.add_argument("--save", action="store_true", help="persist to flash")
    x = add("detect", cmd_detect, "probe the bus, IDENTIFY, choose geometry (optionally mount)")
    x.add_argument("--device", choices=["auto", "master", "slave"], default="auto")
    x.add_argument("--geometry", choices=list(GEOMETRY_MODES), default="auto",
                   help="auto = LBA if supported, else NORMAL (default)")
    x.add_argument("--chs", type=_chs, help="C/H/S for --geometry manual")
    x.add_argument("--no-probe", action="store_true", help="skip bus reset/probe; just IDENTIFY")
    x.add_argument("--force", action="store_true", help="accept manual geometry if IDENTIFY fails")
    x.add_argument("--mount", action="store_true", help="mount on success")
    x = add("geometry", cmd_geometry, "set geometry from cached IDENTIFY data or manual C/H/S")
    x.add_argument("mode", choices=["normal", "large", "lba", "manual"])
    x.add_argument("--chs", type=_chs)
    x = add("mount", cmd_mount, "expose the drive as USB mass storage (and rescan the host disk)")
