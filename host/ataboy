#!/usr/bin/env python3
"""ataboy - command-line client and Python library for the ATAboy automation API.

Talks to the ATAboy firmware over the USB mass-storage (SCSI) interface using
the Linux SG_IO ioctl: vendor command 0xC0 for the ATAboy API and SAT ATA
PASS-THROUGH (16) for raw ATA commands.  Standard library only.

    ataboy status                 # what is attached, geometry, mount state, errors
    ataboy detect --mount         # probe, IDENTIFY, pick geometry, mount
    ataboy -j read 19969 --through-error --out s.bin
    ataboy verify 0 336260        # drive-internal surface scan, lists bad LBAs
    ataboy log                    # failed commands with full ATA registers

Every command accepts -j/--json for machine-readable output (or set
ATABOY_JSON=1).  Exit status: 0 ok, 1 device reported a failure, 2 usage
error, 3 transport/device-not-found error, 4 permission error.

As a library:

    from ataboy import ATAboy           # (copy or symlink this file to ataboy.py)
    with ATAboy() as dev:
        print(dev.status()["geometry"])
        r = dev.read(19969, 1, through_error=True)

Protocol reference: docs/API.md in the firmware repository.
"""

import argparse
import ctypes
import errno
import fcntl
import glob
import json
import os
import struct
import subprocess
import sys
import time

__version__ = "1.0.0"
API_PROTO = 1

# ---------------------------------------------------------------------------
#  SG_IO transport
# ---------------------------------------------------------------------------

SG_IO = 0x2285
SG_DXFER_NONE = -1
SG_DXFER_TO_DEV = -2
SG_DXFER_FROM_DEV = -3


class _SgIoHdr(ctypes.Structure):
    _fields_ = [
        ("interface_id", ctypes.c_int),
        ("dxfer_direction", ctypes.c_int),
        ("cmd_len", ctypes.c_ubyte),
        ("mx_sb_len", ctypes.c_ubyte),
        ("iovec_count", ctypes.c_ushort),
        ("dxfer_len", ctypes.c_uint),
        ("dxferp", ctypes.c_void_p),
        ("cmdp", ctypes.c_void_p),
        ("sbp", ctypes.c_void_p),
        ("timeout", ctypes.c_uint),
        ("flags", ctypes.c_uint),
        ("pack_id", ctypes.c_int),
        ("usr_ptr", ctypes.c_void_p),
        ("status", ctypes.c_ubyte),
        ("masked_status", ctypes.c_ubyte),
        ("msg_status", ctypes.c_ubyte),
        ("sb_len_wr", ctypes.c_ubyte),
        ("host_status", ctypes.c_ushort),
        ("driver_status", ctypes.c_ushort),
        ("resid", ctypes.c_int),
        ("duration", ctypes.c_uint),
        ("info", ctypes.c_uint),
    ]


class TransportError(Exception):
    """The SCSI command could not be delivered or the device is missing."""


class ScsiCheckCondition(Exception):
    """The device answered CHECK CONDITION; .sense holds the sense bytes."""

    def __init__(self, sense, status=2):
        self.sense = bytes(sense)
        self.status = status
        self.key, self.asc, self.ascq = parse_sense_key(self.sense)
        super().__init__("CHECK CONDITION sense %s (key %02x asc %02x ascq %02x)"
                         % (self.sense.hex(), self.key, self.asc, self.ascq))


class ApiError(Exception):
    """The ATAboy API reported a non-ok result; .reply is the full Reply."""

    def __init__(self, reply):
        self.reply = reply
        msg = reply.result_name
        if isinstance(reply.json, dict) and reply.json.get("message"):
            msg += ": " + reply.json["message"]
        super().__init__(msg)


def parse_sense_key(sense):
    if len(sense) < 3:
        return 0, 0, 0
    code = sense[0] & 0x7F
    if code in (0x72, 0x73):
        return sense[1] & 0x0F, sense[2] if len(sense) > 2 else 0, sense[3] if len(sense) > 3 else 0
    return (sense[2] & 0x0F, sense[12] if len(sense) > 12 else 0,
            sense[13] if len(sense) > 13 else 0)


def sgio(fd, cdb, direction, data=None, length=0, timeout_ms=60000):
    """Issue one SCSI command.  Returns (data_in_bytes, resid).
    Raises ScsiCheckCondition / TransportError."""
    cdb = bytes(cdb)
    cdb_buf = ctypes.create_string_buffer(cdb, len(cdb))
    sense_buf = ctypes.create_string_buffer(96)
    if direction == SG_DXFER_TO_DEV:
        data = bytes(data)
        length = len(data)
        dbuf = ctypes.create_string_buffer(data, length)
    elif direction == SG_DXFER_FROM_DEV:
        dbuf = ctypes.create_string_buffer(length)
    else:
        dbuf = None
        length = 0
    h = _SgIoHdr()
    h.interface_id = ord("S")
    h.dxfer_direction = direction
    h.cmd_len = len(cdb)
    h.mx_sb_len = len(sense_buf)
    h.dxfer_len = length
    h.dxferp = ctypes.cast(dbuf, ctypes.c_void_p) if dbuf is not None else None
    h.cmdp = ctypes.cast(cdb_buf, ctypes.c_void_p)
    h.sbp = ctypes.cast(sense_buf, ctypes.c_void_p)
    h.timeout = int(timeout_ms)
    try:
        fcntl.ioctl(fd, SG_IO, h)
    except OSError as e:
        if e.errno in (errno.EPERM, errno.EACCES):
            raise PermissionError("SG_IO needs root (CAP_SYS_RAWIO) for vendor/pass-through commands") from e
        raise TransportError("SG_IO ioctl failed: %s" % e) from e
    sense = sense_buf.raw[:h.sb_len_wr]
    if h.host_status or (h.driver_status & 0x0F and not sense):
        raise TransportError("transport error host_status=0x%x driver_status=0x%x"
                             % (h.host_status, h.driver_status))
    if h.status == 0x02 or (h.masked_status == 0x01) or sense:
        if h.status != 0 or sense:
            raise ScsiCheckCondition(sense, h.status)
    if h.status not in (0,):
        raise TransportError("SCSI status 0x%02x" % h.status)
    got = b""
    if direction == SG_DXFER_FROM_DEV:
        n = max(0, length - h.resid)
        got = dbuf.raw[:n]
    return got, h.resid


# ---------------------------------------------------------------------------
#  Device discovery
# ---------------------------------------------------------------------------

def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def find_devices():
    """All attached ATAboys: list of dicts with block/sg device paths."""
    out = []
    for blk in sorted(glob.glob("/sys/block/sd*")):
        if _read(blk + "/device/vendor") != "ATAboy":
            continue
        name = os.path.basename(blk)
        sg = glob.glob(blk + "/device/scsi_generic/sg*")
        out.append({
            "block": "/dev/" + name,
            "sg": "/dev/" + os.path.basename(sg[0]) if sg else None,
            "rev": _read(blk + "/device/rev"),
            "size_sectors": int(_read(blk + "/size") or 0),
            "scsi_timeout_s": int(_read(blk + "/device/timeout") or 0),
            "sysfs": os.path.realpath(blk + "/device"),
        })
    return out


# ---------------------------------------------------------------------------
#  Decoders
# ---------------------------------------------------------------------------

ST_BITS = [(0x80, "BSY"), (0x40, "DRDY"), (0x20, "DF"), (0x10, "DSC"),
           (0x08, "DRQ"), (0x04, "CORR"), (0x02, "IDX"), (0x01, "ERR")]
ER_BITS = [(0x80, "BBK"), (0x40, "UNC"), (0x20, "MC"), (0x10, "IDNF"),
           (0x08, "MCR"), (0x04, "ABRT"), (0x02, "TK0NF"), (0x01, "AMNF")]


def bits(v, table):
    return "|".join(n for m, n in table if v & m)


RESULTS = ["ok", "bad_subop", "bad_arg", "no_drive", "not_mounted", "write_protected",
           "not_armed", "ata_error", "timeout", "not_ready", "bus_fault", "no_geometry",
           "mounted", "identify_failed", "unsupported", "protocol", "alloc_too_small"]
IDE_RESULTS = {0: "ok", -1: "ata_error", -2: "timeout", -3: "not_ready", -4: "bus_fault", -5: "protocol"}

CT_NONE, CT_JSON, CT_BINARY = 0, 1, 2

OPS = {
    "info": 0x00, "status": 0x01, "config_get": 0x02, "config_set": 0x03,
    "config_save": 0x04, "config_defaults": 0x05, "detect": 0x10, "geometry": 0x11,
    "mount": 0x12, "unmount": 0x13, "reset": 0x14, "identify": 0x20, "taskfile": 0x21,
    "read": 0x22, "read_long": 0x23, "verify": 0x24, "corrupt": 0x25, "log": 0x30, "log_clear": 0x31,
    "arm": 0x40, "reboot": 0x41,
}

CONFIG_KEYS = {
    "write_protect": (1, "bool"), "auto_mount": (2, "bool"), "iordy": (3, "bool"),
    "intrq": (4, "bool"), "read_timeout_ms": (5, "int"), "write_timeout_ms": (6, "int"),
    "ecc_len": (7, "int"), "no_retry": (8, "bool"), "device": (9, "device"),
}

GEOMETRY_MODES = {"auto": 0, "normal": 1, "large": 2, "lba": 3, "manual": 4, "keep": 5}


class Reply:
    """Decoded API reply (16-byte header + JSON or binary payload)."""
    HDR = struct.Struct(">2sBBBBHIB3x")

    def __init__(self, raw):
        if len(raw) < 16:
            raise TransportError("short reply (%d bytes)" % len(raw))
        magic, proto, op, result, ctype, plen, uptime, flags = self.HDR.unpack_from(raw)
        if magic != b"AB":
            raise TransportError("bad reply magic %r - is the API firmware loaded?" % magic)
        self.proto, self.op, self.result, self.ctype = proto, op, result, ctype
        self.uptime_ms, self.flags = uptime, flags
        self.payload = raw[16:16 + plen]
        if len(self.payload) < plen:
            raise TransportError("truncated reply: %d of %d payload bytes" % (len(self.payload), plen))
        self.json = None
        if ctype == CT_JSON:
            try:
                self.json = json.loads(self.payload.decode("utf-8"))
            except ValueError as e:
                raise TransportError("device sent malformed JSON: %s" % e)

    @property
    def ok(self):
        return self.result == 0

    @property
    def result_name(self):
        return RESULTS[self.result] if self.result < len(RESULTS) else "result_%d" % self.result

    @property
    def flag_dict(self):
        f = self.flags
        return {"mounted": bool(f & 1), "write_protect": bool(f & 2), "identified": bool(f & 4),
                "armed": bool(f & 8), "geometry_valid": bool(f & 16)}


class AtaResult:
    """Binary ATA result block (32 bytes) + data from read/read_long/verify."""
    FMT = struct.Struct(">IHHBBBBII5sBbxI")

    def __init__(self, payload, op_result):
        (self.lba, self.count, self.done, self.status, self.error, self.command, fl,
         self.elapsed_us, fail_lba, tf, self.ecc_len, ide_res, done32) = self.FMT.unpack_from(payload)
        self.timed_out = bool(fl & 0x01)
        self.err_data = bool(fl & 0x02)
        self.tf_valid = bool(fl & 0x04)
        self.recovered = bool(fl & 0x08)
        self.bus_fault = bool(fl & 0x10)
        self.not_ready = bool(fl & 0x20)
        self.partial = bool(fl & 0x40)
        self.fail_lba = None if fail_lba == 0xFFFFFFFF else fail_lba
        self.tf = list(tf)
        self.ide_result = IDE_RESULTS.get(ide_res, str(ide_res))
        self.result = RESULTS[op_result] if op_result < len(RESULTS) else str(op_result)
        self.data = payload[32:]
        if self.command in (0x40, 0x41, 0x42):          # VERIFY carries a 32-bit count
            self.done = done32

    @property
    def ok(self):
        return self.result == "ok"

    def to_dict(self, with_data=False):
        d = {
            "result": self.result, "ide_result": self.ide_result, "lba": self.lba,
            "count": self.count, "done": self.done, "command": self.command,
            "status": self.status, "status_bits": bits(self.status, ST_BITS),
            "error": self.error, "error_bits": bits(self.error, ER_BITS),
            "timed_out": self.timed_out, "err_data": self.err_data, "tf_valid": self.tf_valid,
            "recovered": self.recovered, "bus_fault": self.bus_fault, "not_ready": self.not_ready,
            "partial": self.partial, "fail_lba": self.fail_lba, "elapsed_ms": round(self.elapsed_us / 1000, 3),
            "tf": self.tf if self.tf_valid else None, "data_bytes": len(self.data),
        }
        if self.ecc_len:
            d["ecc_len"] = self.ecc_len
        if with_data:
            d["data_hex"] = self.data.hex()
        return d


def ata_string(words, lo, hi):
    raw = b"".join(struct.pack(">H", w) for w in words[lo:hi])
    return raw.decode("ascii", "replace").strip().strip("\x00")


def decode_identify(raw):
    """Decode the useful parts of IDENTIFY DEVICE data."""
    w = struct.unpack("<256H", raw[:512])
    lba28 = w[60] | (w[61] << 16)
    lba48 = w[100] | (w[101] << 16) | (w[102] << 32) | (w[103] << 48)
    sup = lambda word, bit: w[word] != 0xFFFF and bool(w[word] & (1 << bit))
    major = w[80] if w[80] not in (0, 0xFFFF) else 0
    ata_versions = [n for n in range(1, 15) if major & (1 << n)]
    pio = ["PIO0-2"]
    if w[53] & 2:
        pio += ["PIO%d" % (3 + i) for i in range(2) if w[64] & (1 << i)]
    udma = [i for i in range(8) if (w[53] & 4) and w[88] & (1 << i)]
    integ = None
    if (w[255] & 0xFF) == 0xA5:
        integ = (sum(raw[:512]) & 0xFF) == 0
    d = {
        "model": ata_string(w, 27, 47),
        "serial": ata_string(w, 10, 20),
        "firmware": ata_string(w, 23, 27),
        "default_chs": [w[1], w[3], w[6]],
        "default_chs_sectors": w[1] * w[3] * w[6],
        "current_chs": [w[54], w[55], w[56]] if w[53] & 1 else None,
        "lba": bool(w[49] & 0x200),
        "lba28_sectors": lba28,
        "lba48": sup(83, 10),
        "lba48_sectors": lba48,
        "capacity_bytes": (lba48 if sup(83, 10) and lba48 else (lba28 if w[49] & 0x200 else w[1] * w[3] * w[6])) * 512,
        "ecc_bytes": w[22],
        "buffer_kib": w[21] // 2,
        "max_multiple": w[47] & 0xFF,
        "iordy": bool(w[49] & 0x800),
        "dma": bool(w[49] & 0x100),
        "pio_modes": pio,
        "udma_modes": udma,
        "ata_versions": ata_versions,
        "smart": sup(82, 0), "smart_enabled": sup(85, 0),
        "security": sup(82, 1), "security_status": w[128],
        "write_cache": sup(82, 5), "write_cache_enabled": sup(85, 5),
        "hpa": sup(82, 10),
        "integrity_ok": integ,
    }
    return d


# ---------------------------------------------------------------------------
#  The device
# ---------------------------------------------------------------------------

class ATAboy:
    """One ATAboy.  path = /dev/sgN or /dev/sdX (default: first one found)."""

    def __init__(self, path=None):
        self.info_dev = None
        if path is None:
            devs = find_devices()
            if not devs:
                raise TransportError("no ATAboy found (no /sys/block/sd* with vendor 'ATAboy')")
            self.info_dev = devs[0]
            path = devs[0]["sg"] or devs[0]["block"]
        else:
            for d in find_devices():
                if path in (d["sg"], d["block"]):
                    self.info_dev = d
        self.path = path
        flags = os.O_RDWR if "/sg" in path else os.O_RDONLY | os.O_NONBLOCK
        try:
            self.fd = os.open(path, flags)
        except PermissionError:
            raise
        except OSError as e:
            raise TransportError("cannot open %s: %s" % (path, e))

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()

    # -- raw API call --------------------------------------------------------

    def call(self, op, args=b"", alloc=4096, timeout_ms=60000, check=False):
        if isinstance(op, str):
            op = OPS[op]
        args = bytes(args)[:12]
        cdb = bytes([0xC0, op, ord("A"), ord("B")]) + args + bytes(12 - len(args))
        data, _ = sgio(self.fd, cdb, SG_DXFER_FROM_DEV, length=alloc, timeout_ms=timeout_ms)
        r = Reply(data)
        if r.proto != API_PROTO:
            raise TransportError("device speaks API protocol %d, this client %d" % (r.proto, API_PROTO))
        if check and not r.ok:
            raise ApiError(r)
        return r

    def _json(self, op, args=b"", timeout_ms=60000, check=True):
        r = self.call(op, args, timeout_ms=timeout_ms, check=check)
        return r.json

    # -- state / config --------------------------------------------------------

    def info(self):
        return self._json("info")

    def status(self):
        return self._json("status")

    def config(self):
        return self._json("config_get")["config"]

    def set_config(self, key, value):
        num, kind = CONFIG_KEYS[key]
        if kind == "bool":
            v = 1 if value in (True, 1, "1", "on", "true", "yes", "enabled") else 0
        elif kind == "device":
            v = {"master": 0, "slave": 1, "0": 0, "1": 1, 0: 0, 1: 1}[value]
        else:
            v = int(value)
        j = self._json("config_set", struct.pack(">B3xI", num, v))
        if key == "read_timeout_ms":
            self.ensure_kernel_timeout(v)
        if key == "write_protect" and j.get("config") and self.info_dev:
            self.rescan(wait_s=1.0)       # kernel re-reads the WP bit (sysfs ro)
        return j["config"]

    def save(self):
        return self._json("config_save")

    def defaults(self):
        return self._json("config_defaults")

    def ensure_kernel_timeout(self, fw_timeout_ms):
        """Make the kernel's SCSI timeout for /dev/sdX longer than the firmware
        per-sector timeout so the host doesn't abort a read the drive is still retrying."""
        if not self.info_dev:
            return None
        path = self.info_dev["sysfs"] + "/timeout"
        need = fw_timeout_ms // 1000 + 30
        try:
            cur = int(_read(path) or 0)
            if cur < need:
                with open(path, "w") as f:
                    f.write(str(need))
                return need
            return cur
        except OSError:
            return None

    # -- drive setup -----------------------------------------------------------

    def detect(self, device="auto", geometry="auto", chs=None, probe=True, force=False, mount=False):
        dev = {"auto": 0, "master": 1, "slave": 2}[device]
        geo = GEOMETRY_MODES[geometry]
        c, h, s = chs or (0, 0, 0)
        flags = (0 if probe else 1) | (2 if mount else 0) | (4 if force else 0)
        r = self.call("detect", struct.pack(">BBHBBB", dev, geo, c, h, s, flags), timeout_ms=120000)
        if r.ok and mount:
            self.rescan()
        return r

    def geometry(self, mode, chs=None):
        c, h, s = chs or (0, 0, 0)
        return self.call("geometry", struct.pack(">BBHBB", 0, GEOMETRY_MODES[mode], c, h, s))

    def mount(self, rescan=True):
        r = self.call("mount")
        if r.ok and rescan:
            self.rescan()
        return r

    def unmount(self, rescan=True):
        r = self.call("unmount")
        if r.ok and rescan:
            self.rescan()
        return r

    def rescan(self, wait_s=5.0):
        """Ask the kernel to re-read capacity; returns the new size in sectors."""
        if not self.info_dev:
            return None
        try:
            with open(self.info_dev["sysfs"] + "/rescan", "w") as f:
                f.write("1")
        except OSError:
            return None
        blk = "/sys/block/" + os.path.basename(self.info_dev["block"]) + "/size"
        t0 = time.time()
        size = int(_read(blk) or 0)
        st = self.status()
        want = st["geometry"]["sectors"] if st["mounted"] else 0
        while size != want and time.time() - t0 < wait_s:
            time.sleep(0.25)
            try:
                with open(self.info_dev["sysfs"] + "/rescan", "w") as f:
                    f.write("1")
            except OSError:
                pass
            size = int(_read(blk) or 0)
        return size

    def reset(self, hard=False):
        return self.call("reset", bytes([1 if hard else 0]), timeout_ms=60000)

    # -- data / diagnostics ------------------------------------------------------

    def identify(self, cached=False):
        r = self.call("identify", bytes([1 if cached else 0]), check=True)
        return r.payload[:512]

    def taskfile(self):
        return self._json("taskfile")

    def read(self, lba, count=1, no_retry=False, through_error=False, timeout_ms=0):
        """Read 1..max_read_sectors sectors with full ATA diagnostics."""
        flags = (1 if no_retry else 0) | (2 if through_error else 0)
        # The firmware enforces the real per-sector timeout; the host timeout only
        # has to be longer.  Without an explicit value assume the 600 s maximum.
        sg_t = (timeout_ms or 600000) * count + 15000
        r = self.call("read", struct.pack(">IHBxI", lba, count, flags, timeout_ms), timeout_ms=sg_t)
        if r.ctype != CT_BINARY:
            raise ApiError(r)
        return AtaResult(r.payload, r.result)

    def read_long(self, lba, ecc_len=0, no_retry=False, timeout_ms=0):
        flags = 1 if no_retry else 0
        sg_t = (timeout_ms or 600000) + 15000
        r = self.call("read_long", struct.pack(">IBxBxI", lba, ecc_len, flags, timeout_ms), timeout_ms=sg_t)
        if r.ctype != CT_BINARY:
            raise ApiError(r)
        return AtaResult(r.payload, r.result)

    def verify(self, lba, count, timeout_ms=0):
        """One VERIFY request (firmware stops after ~10 s; check .partial)."""
        sg_t = 10000 + (timeout_ms or 600000) + 30000
        r = self.call("verify", struct.pack(">III", lba, count, timeout_ms), timeout_ms=sg_t)
        if r.ctype != CT_BINARY:
            raise ApiError(r)
        return AtaResult(r.payload, r.result)

    def corrupt(self, lba, bits=16, ecc_len=0):
        """DESTRUCTIVE test helper: flip 'bits' data bits in a sector and write it
        back with its old ECC (WRITE LONG), creating a correctable or UNC sector.
        Needs write protect off; arms itself.  Rewrite the sector to repair it."""
        self.arm()
        r = self.call("corrupt", struct.pack(">IBB", lba, bits, ecc_len), timeout_ms=60000)
        if r.ctype != CT_BINARY:
            raise ApiError(r)
        return AtaResult(r.payload, r.result)

    def log(self):
        """All retained error-log entries (pages through the device log)."""
        entries, start, total = [], 0, 0
        while True:
            j = self._json("log", struct.pack(">I", start))
            total = j["total"]
            entries += j["entries"]
            if j["next"] is None or j["returned"] == 0:
                break
            start = j["next"]
        return {"total": total, "retained": len(entries), "entries": entries}

    def clear(self, log=True, stats=False):
        return self._json("log_clear", bytes([(1 if log else 0) | (2 if stats else 0)]))

    def arm(self):
        return self._json("arm", b"ARM!")

    def reboot(self, bootsel=False):
        return self._json("reboot", bytes([1 if bootsel else 0, 0, 0, 0]) + b"BOOT")

    # -- multi-step operations (shared by the CLI and the MCP server) --------------

    def scan(self, lba, count, timeout_ms=0, max_errors=0, time_budget_s=0, progress=None):
        """READ VERIFY scan of [lba, lba+count).  Bad sectors are skipped one at a
        time.  Returns a dict; 'next_lba' < end means the time budget ran out."""
        end, cur, bad, t0, requests = lba + count, lba, [], time.time(), 0
        while cur < end:
            if time_budget_s and time.time() - t0 > time_budget_s:
                break
            # One firmware VERIFY request may run ~10 s; with a budget, keep each
            # request small (~2 s at old-drive speeds) so the budget is honoured.
            n = end - cur if not time_budget_s else min(end - cur, 8192)
            r = self.verify(cur, n, timeout_ms=timeout_ms)
            requests += 1
            cur += r.done
            if r.result != "ok":
                bad.append({"lba": cur, "status": r.status, "error": r.error,
                            "error_bits": bits(r.error, ER_BITS), "ide_result": r.ide_result})
                if progress:
                    progress("bad LBA %d  st %02X err %02X[%s] %s" % (cur, r.status, r.error,
                                                                    bits(r.error, ER_BITS), r.ide_result))
                cur += 1
                if max_errors and len(bad) >= max_errors:
                    break
        return {"result": "ok" if not bad else "errors", "start": lba, "count": count,
                "scanned": cur - lba, "next_lba": cur if cur < end else None,
                "complete": cur >= end, "bad": bad, "bad_lbas": [b["lba"] for b in bad],
                "seconds": round(time.time() - t0, 1), "requests": requests}

    def read_range(self, lba, count, out=None, image=False, no_retry=False, through_error=False,
                   timeout_ms=0, keep_going=False, keep_data=False, time_budget_s=0):
        """Read [lba, lba+count) through the API in max-size chunks with per-chunk
        diagnostics.  out: file path written at (lba-start)*512, or at lba*512 when
        image=True (in place).  After an error, continues sector by sector."""
        maxn = self.info().get("max_read_sectors", 7)
        end, cur, chunks, bad, ok_sectors, t0 = lba + count, lba, [], [], 0, time.time()
        data = bytearray() if keep_data else None
        f = None
        if out:
            f = open(out, "r+b" if image and os.path.exists(out) else "wb")
        try:
            while cur < end:
                if time_budget_s and time.time() - t0 > time_budget_s:
                    break
                n = min(maxn, end - cur) if not bad else 1
                r = self.read(cur, n, no_retry=no_retry, through_error=through_error, timeout_ms=timeout_ms)
                got = r.done + (1 if r.err_data else 0)
                if f and got:
                    f.seek((cur if image else cur - lba) * 512)
                    f.write(r.data[:got * 512])
                if data is not None:
                    data += r.data[:got * 512]
                ok_sectors += r.done
                chunks.append(r.to_dict())
                if r.ok:
                    cur += n
                    continue
                fl = r.fail_lba if r.fail_lba is not None else cur + r.done
                bad.append(fl)
                if not keep_going:
                    cur = fl
                    break
                cur = max(fl + 1, cur + max(1, r.done))
        finally:
            if f:
                f.close()
        res = {"result": "ok" if not bad else "errors", "start": lba, "count": count,
               "ok_sectors": ok_sectors, "bad_lbas": bad, "next_lba": cur if cur < end else None,
               "seconds": round(time.time() - t0, 1),
               "chunks": [c for c in chunks if c["result"] != "ok"] if len(chunks) > 20 else chunks}
        if data is not None:
            res["data"] = bytes(data)
        return res

    def read_long_vote(self, lba, votes=1, ecc_len=0, no_retry=False, timeout_ms=0):
        """READ LONG 'votes' times and majority-vote every byte.  Returns
        (payload_or_None, info_dict); payload is 512 data bytes + ECC."""
        reads = []
        for _ in range(max(1, votes)):
            r = self.read_long(lba, ecc_len=ecc_len, no_retry=no_retry, timeout_ms=timeout_ms)
            reads.append(r)
            if not r.data:
                break
        last = reads[-1]
        info = last.to_dict()
        good = [r.data for r in reads if r.data]
        if not good:
            return None, info
        n = len(good[0])
        voted, unstable = bytearray(n), 0
        for i in range(n):
            col = [d[i] for d in good]
            best = max(set(col), key=col.count)
            voted[i] = best
            unstable += len(set(col)) > 1
        info["vote"] = {"reads": len(good), "unstable_bytes": unstable}
        info["ecc_hex"] = bytes(voted[512:]).hex()
        return bytes(voted), info

    def image(self, out, mapfile=None, start=0, count=None, chunk_sectors=128, time_budget_s=0,
              progress=None):
        """Image the mounted drive through the USB disk (/dev/sdX, O_DIRECT) into
        'out', keeping a ddrescue-compatible mapfile so the run can be resumed
        and then handed to rescue().  Chunks that fail are re-read sector by
        sector; unreadable sectors are marked '-'."""
        import mmap
        if not self.info_dev:
            raise TransportError("imaging needs the block device of a discovered ATAboy")
        st = self.status()
        if not st["mounted"]:
            raise ApiError(Reply(b"AB\x01\x00\x04\x01\x00\x00" + bytes(8)))
        total = st["geometry"]["sectors"]
        end = total if count is None else min(total, start + count)
        mapfile = mapfile or out + ".map"
        if os.path.exists(mapfile):
            m = Mapfile.load(mapfile)
        else:
            m = Mapfile(mapfile, ["# Mapfile. Created by ataboy " + __version__],
                        "0x00000000     ?               1", [[0, total * 512, "?"]])
        todo = []
        for pos, size, s in m.blocks:
            if s == "?":
                a, b = max(pos // 512, start), min((pos + size) // 512, end)
                if a < b:
                    todo.append((a, b))
        fd = os.open(self.info_dev["block"], os.O_RDONLY | os.O_DIRECT)
        buf = mmap.mmap(-1, chunk_sectors * 512)
        one = mmap.mmap(-1, 4096)
        mode = "r+b" if os.path.exists(out) else "w+b"
        t0, done, bad, last_save = time.time(), 0, [], time.time()
        complete = True
        try:
            with open(out, mode) as img:
                img.truncate(max(os.path.getsize(out), total * 512))
                for a, b in todo:
                    lba = a
                    while lba < b:
                        if time_budget_s and time.time() - t0 > time_budget_s:
                            complete = False
                            break
                        n = min(chunk_sectors, b - lba)
                        try:
                            got = os.preadv(fd, [memoryview(buf)[:n * 512]], lba * 512)
                            if got != n * 512:
                                raise OSError(errno.EIO, "short read")
                            img.seek(lba * 512)
                            img.write(memoryview(buf)[:n * 512])
                            m.mark(lba, n, "+")
                            done += n
                        except OSError:
                            for s in range(lba, lba + n):          # isolate the bad sector(s)
                                try:
                                    if os.preadv(fd, [memoryview(one)[:512]], s * 512) != 512:
                                        raise OSError(errno.EIO, "short read")
                                    img.seek(s * 512)
                                    img.write(memoryview(one)[:512])
                                    m.mark(s, 1, "+")
                                    done += 1
                                except OSError:
                                    m.mark(s, 1, "-")
                                    bad.append(s)
                                    if progress:
                                        progress("bad LBA %d" % s)
                        lba += n
                        if time.time() - last_save > 10:
                            m.save()
                            last_save = time.time()
                            if progress:
                                progress("  %d sectors imaged, %d bad, %.0f kB/s" % (
                                    done, len(bad), done * 0.512 / max(0.001, time.time() - t0)))
                    if not complete:
                        break
        finally:
            os.close(fd)
            m.save()
        secs = time.time() - t0
        return {"result": "ok" if not bad else "errors", "image": out, "mapfile": mapfile,
                "imaged_sectors": done, "bad_lbas": bad, "complete": complete,
                "map": m.summary(), "seconds": round(secs, 1),
                "kB_per_s": round(done * 0.512 / secs, 1) if secs else None}

    def rescue(self, image, mapfile, timeout_ms=15000, votes=5, readlong=True,
               no_retry_pass=True, max_sectors=0, time_budget_s=0, progress=None,
               include_untried=False):
        """Targeted recovery after ddrescue: retry only the sectors the mapfile
        marks non-finished, gentlest first, writing recovered data into the image
        and updating the mapfile.  READ LONG results go into the image but stay
        marked bad in the map; they are listed in IMAGE.readlong.json."""
        m = Mapfile.load(mapfile)
        targets = m.bad_sectors(max_sectors, include_untried=include_untried)
        t0 = time.time()
        rec = {"result": "ok", "image": image, "mapfile": mapfile, "candidates": len(targets),
               "recovered_no_retry": [], "recovered_retry": [], "readlong": [], "still_bad": [],
               "complete": True}
        say = progress or (lambda s: None)

        def budget_left():
            return not time_budget_s or time.time() - t0 < time_budget_s

        with open(image, "r+b") as img:
            def put(lba, data):
                img.seek(lba * 512)
                img.write(data[:512])

            remaining = list(targets)
            # Pass 1: no drive retries, single sectors (fast fail, gentle)
            if no_retry_pass:
                nxt = []
                for lba in remaining:
                    if not budget_left():
                        nxt.append(lba)
                        continue
                    r = self.read(lba, 1, no_retry=True, timeout_ms=min(timeout_ms, 5000))
                    if r.ok:
                        put(lba, r.data)
                        m.mark(lba, 1, "+")
                        rec["recovered_no_retry"].append(lba)
                        say("LBA %d recovered (no-retry pass)" % lba)
                    else:
                        nxt.append(lba)
                remaining = nxt
                m.save()
            # Pass 2: drive retries, long timeout
            nxt = []
            for lba in remaining:
                if not budget_left():
                    nxt.append(lba)
                    continue
                r = self.read(lba, 1, timeout_ms=timeout_ms)
                if r.ok:
                    put(lba, r.data)
                    m.mark(lba, 1, "+")
                    rec["recovered_retry"].append(lba)
                    say("LBA %d recovered with drive retries (%.0f ms)" % (lba, r.elapsed_us / 1000))
                else:
                    nxt.append(lba)
            remaining = nxt
            m.save()
            # Pass 3: READ LONG majority vote (data without ECC correction)
            sidecar_path = image + ".readlong.json"
            sidecar = {}
            if readlong and remaining:
                if os.path.exists(sidecar_path):
                    with open(sidecar_path) as sf:
                        sidecar = json.load(sf)
                nxt = []
                for lba in remaining:
                    if not budget_left():
                        nxt.append(lba)
                        continue
                    payload, info = self.read_long_vote(lba, votes=votes, timeout_ms=timeout_ms)
                    if payload is None:
                        nxt.append(lba)
                        continue
                    put(lba, payload)
                    entry = {"lba": lba, "ecc_hex": info["ecc_hex"], "votes": info["vote"]["reads"],
                             "unstable_bytes": info["vote"]["unstable_bytes"],
                             "status": info["status"], "error_bits": info["error_bits"]}
                    sidecar[str(lba)] = entry
                    rec["readlong"].append(entry)
                    nxt.append(lba)          # still bad in the map: data is unverified
                    say("LBA %d: READ LONG data written (%d unstable bytes over %d reads)"
                        % (lba, entry["unstable_bytes"], entry["votes"]))
                with open(sidecar_path, "w") as sf:
                    json.dump(sidecar, sf, indent=1, sort_keys=True)
                rec["readlong_sidecar"] = sidecar_path
                remaining = nxt
        rec["still_bad"] = remaining
        rec["complete"] = budget_left()
        rec["recovered"] = len(rec["recovered_no_retry"]) + len(rec["recovered_retry"])
        rec["seconds"] = round(time.time() - t0, 1)
        if remaining:
            rec["result"] = "partial"
        m.save()
        return rec

    # -- raw ATA pass-through (SAT ATA PASS-THROUGH 16) ----------------------------

    def ata(self, command, feature=0, count=0, lba=0, device=0, ext=False,
            data_in=0, data_out=None, ck_cond=True, timeout_ms=60000):
        """Issue a raw ATA command.  data_in = bytes to read (multiple of 512),
        data_out = bytes to write.  Returns dict with registers (+ 'data')."""
        if data_out is not None:
            proto, t_dir, n = 5, 0, len(data_out)
        elif data_in:
            proto, t_dir, n = 4, 1, data_in
        else:
            proto, t_dir, n = 3, 0, 0
        b1 = (proto << 1) | (1 if ext else 0)
        b2 = (0x20 if ck_cond else 0) | (t_dir << 3) | ((0x04 | 0x02) if n else 0)
        cdb = bytes([0x85, b1, b2,
                     (feature >> 8) & 0xFF, feature & 0xFF,
                     (count >> 8) & 0xFF, count & 0xFF,
                     (lba >> 24) & 0xFF, lba & 0xFF,
                     (lba >> 32) & 0xFF, (lba >> 8) & 0xFF,
                     (lba >> 40) & 0xFF, (lba >> 16) & 0xFF,
                     device & 0xFF, command & 0xFF, 0])
        out = {"command": command, "ok": True}
        data = b""
        try:
            if data_out is not None:
                sgio(self.fd, cdb, SG_DXFER_TO_DEV, data=data_out, timeout_ms=timeout_ms)
            elif data_in:
                data, _ = sgio(self.fd, cdb, SG_DXFER_FROM_DEV, length=data_in, timeout_ms=timeout_ms)
            else:
                sgio(self.fd, cdb, SG_DXFER_NONE, timeout_ms=timeout_ms)
        except ScsiCheckCondition as e:
            regs = parse_ata_return(e.sense)
            out["sense"] = e.sense.hex()
            out["sense_key"] = e.key
            if regs is None:
                out["ok"] = False
                out["blocked"] = {(7, 0x27, 0): "write_protected", (7, 0x20, 2): "not_armed",
                                  (5, 0x24, 0): "invalid_field"}.get((e.key, e.asc, e.ascq), "rejected")
                return out
            out.update(regs)
            out["ok"] = e.key == 1           # RECOVERED ERROR = ck_cond report on success
        out["data"] = data
        return out


class Mapfile:
    """GNU ddrescue mapfile (byte positions, hex).  Status: '?' non-tried,
    '*' non-trimmed, '/' non-scraped, '-' bad, '+' finished."""

    def __init__(self, path, header, cur_line, blocks):
        self.path, self.header, self.cur_line, self.blocks = path, header, cur_line, blocks

    @classmethod
    def load(cls, path):
        header, cur_line, blocks = [], None, []
        with open(path) as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#"):
                    if not blocks and cur_line is None:
                        header.append(line.rstrip("\n"))
                    continue
                parts = s.split()
                if cur_line is None:
                    cur_line = line.rstrip("\n")
                    continue
                blocks.append([int(parts[0], 0), int(parts[1], 0), parts[2]])
        if cur_line is None:
            raise ValueError("%s: not a ddrescue mapfile" % path)
        return cls(path, header, cur_line, blocks)

    def bad_sectors(self, limit=0, include_untried=False):
        """Sectors in tried-and-failed areas ('-', '*', '/'); '?' (never
        tried) only with include_untried."""
        out = []
        for pos, size, st in self.blocks:
            if st == "+" or (st == "?" and not include_untried):
                continue
            for lba in range(pos // 512, (pos + size + 511) // 512):
                out.append(lba)
                if limit and len(out) >= limit:
                    return out
        return out

    def mark(self, lba, n, status):
        a, b = lba * 512, (lba + n) * 512
        new = []
        for pos, size, st in self.blocks:
            end = pos + size
            if end <= a or pos >= b:
                new.append([pos, size, st])
                continue
            if pos < a:
                new.append([pos, a - pos, st])
            lo, hi = max(pos, a), min(end, b)
            new.append([lo, hi - lo, status])
            if end > b:
                new.append([b, end - b, st])
        merged = []
        for blk in new:
            if merged and merged[-1][2] == blk[2] and merged[-1][0] + merged[-1][1] == blk[0]:
                merged[-1][1] += blk[1]
            else:
                merged.append(blk)
        self.blocks = merged

    def summary(self):
        tot = {}
        for _, size, st in self.blocks:
            tot[st] = tot.get(st, 0) + size
        return tot

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            for h in self.header:
                f.write(h + "\n")
            f.write(self.cur_line + "\n")
            f.write("#      pos        size  status\n")
            for pos, size, st in self.blocks:
                f.write("0x%08X  0x%08X  %s\n" % (pos, size, st))
        os.replace(tmp, self.path)


def parse_ata_return(sense):
    """Registers from a SAT ATA Status Return descriptor (descriptor sense)."""
    if len(sense) < 8 or (sense[0] & 0x7F) not in (0x72, 0x73):
        return None
    i, end = 8, 8 + sense[7]
    while i + 1 < min(end, len(sense)):
        code, ln = sense[i], sense[i + 1]
        if code == 0x09 and i + 14 <= len(sense):
            d = sense[i:i + 14]
            ext = d[2] & 1
            return {
                "status": d[13], "status_bits": bits(d[13], ST_BITS),
                "error": d[3], "error_bits": bits(d[3], ER_BITS),
                "count": d[5] | (d[4] << 8 if ext else 0),
                "lba": d[7] | (d[9] << 8) | (d[11] << 16) |
                       ((d[6] << 24) | (d[8] << 32) | (d[10] << 40) if ext else 0),
                "device": d[12],
            }
        i += 2 + ln
    return None


